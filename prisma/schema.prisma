generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String   @default("")
  content     String
  coverImage  String?
  author      String
  tags        String[] @default([])
  readTime    Int      @default(5)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// A course, e.g. "Web Development". Holds an ordered list of Chapters.
model Program {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String   @default("")
  coverImage  String?
  duration    String?
  level       String?
  published   Boolean  @default(true)
  // Free-form UI/display data that doesn't deserve its own columns:
  // icon name, accent colors, tag label, glow color, etc.
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  chapters Chapter[]
}

// One chapter inside a Program (maps to one "category" in the seed data).
// `subjects` holds the structured, studyable topic list:
//   [{ name: string, content: string, keyPoints: string[] }, ...]
// `content` is kept as a legacy/fallback HTML field for chapters that
// don't have structured subjects (or for a custom intro blurb per chapter).
model Chapter {
  id        String   @id @default(cuid())
  programId String
  program   Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  slug      String
  title     String
  content   String   @default("")
  subjects  Json     @default("[]")
  images    String[] @default([])
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([programId, slug])
  @@index([programId])
}
